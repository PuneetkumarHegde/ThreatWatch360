{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],

  "eslint.workingDirectories": [{ "directory": "${workspaceFolder}/frontend" }],
  "typescript.tsdk": "${workspaceFolder}/frontend/node_modules/typescript/lib",
  "tailwindCSS.experimental.configFile": "${workspaceFolder}/frontend/src/index.css",

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": false
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/venv": true,
    "**/dist": true,
    "**/*.db": true
  }
}
